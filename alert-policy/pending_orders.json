{
  "displayName": "Order Backlog > 10 Alert",
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "Backlog count greater than 10",
      "conditionThreshold": {
        "filter": "metric.type=\"custom.googleapis.com/orders/backlog_count\" resource.type=\"global\"",
        "comparison": "COMPARISON_GT",
        "thresholdValue": 10,
        "duration": "300s",
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "notificationChannels": [
    "projects/gcp-xxx-data-xxx/notificationChannels/1303891574518456943"
  ],
   "enabled": true
}
